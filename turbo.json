{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "!.next/dev/**",
        "dist/**",
        "build/**"
      ],
      "cache": false
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^typecheck"
      ]
    },
    "check-types": {
      "dependsOn": [
        "^check-types"
      ]
    },
    "test": {
      "dependsOn": [
        "^build"
      ],
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "check": {
      "cache": false
    },
    "types:check": {
      "cache": false
    },
    "knip": {
      "cache": false
    },
    "format:check": {
      "cache": false
    },
    "@bent/fitness#test:integration": {
      "passThroughEnv": [
        "FITNESS_TEST_DATABASE_URL"
      ],
      "cache": false
    },
    "test:integration": {
      "cache": false
    },
    "test:e2e": {
      "cache": false
    },
    "@bent-build/drive-copilot-web#build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "dist/**"
      ],
      "env": [
        "ALLOW_LOCAL_OAUTH_REDIRECTS",
        "APP_URL",
        "BENT_DRIVE_ADMIN_GITHUB_USERS",
        "BENT_DRIVE_ALLOWED_GITHUB_USERS",
        "CLERK_SECRET_KEY",
        "DATABASE_URL",
        "MCP_ACCESS_TOKEN_TTL_SECONDS",
        "MCP_REFRESH_TOKEN_TTL_DAYS",
        "NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY",
        "TESLA_AUTHORIZATION_ENDPOINT",
        "TESLA_CLIENT_ID",
        "TESLA_CLIENT_SECRET",
        "TESLA_FLEET_API_BASE_URL",
        "TESLA_REDIRECT_URI",
        "TESLA_SCOPES",
        "TESLA_TOKEN_ENDPOINT",
        "TOKEN_ENCRYPTION_KEY"
      ]
    },
    "@bent-build/tesla-contracts#build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "dist/**"
      ],
      "env": [
        "ALLOW_LOCAL_OAUTH_REDIRECTS",
        "APP_URL",
        "BENT_DRIVE_ADMIN_GITHUB_USERS",
        "BENT_DRIVE_ALLOWED_GITHUB_USERS",
        "CLERK_SECRET_KEY",
        "DATABASE_URL",
        "MCP_ACCESS_TOKEN_TTL_SECONDS",
        "MCP_REFRESH_TOKEN_TTL_DAYS",
        "NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY",
        "TESLA_AUTHORIZATION_ENDPOINT",
        "TESLA_CLIENT_ID",
        "TESLA_CLIENT_SECRET",
        "TESLA_FLEET_API_BASE_URL",
        "TESLA_REDIRECT_URI",
        "TESLA_SCOPES",
        "TESLA_TOKEN_ENDPOINT",
        "TOKEN_ENCRYPTION_KEY"
      ]
    },
    "@tesla-bridge/mcp-server#build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "dist/**"
      ],
      "env": [
        "ALLOW_LOCAL_OAUTH_REDIRECTS",
        "APP_URL",
        "BENT_DRIVE_ADMIN_GITHUB_USERS",
        "BENT_DRIVE_ALLOWED_GITHUB_USERS",
        "CLERK_SECRET_KEY",
        "DATABASE_URL",
        "MCP_ACCESS_TOKEN_TTL_SECONDS",
        "MCP_REFRESH_TOKEN_TTL_DAYS",
        "NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY",
        "TESLA_AUTHORIZATION_ENDPOINT",
        "TESLA_CLIENT_ID",
        "TESLA_CLIENT_SECRET",
        "TESLA_FLEET_API_BASE_URL",
        "TESLA_REDIRECT_URI",
        "TESLA_SCOPES",
        "TESLA_TOKEN_ENDPOINT",
        "TOKEN_ENCRYPTION_KEY"
      ]
    },
    "@bent-build/drive-copilot-web#check": {
      "dependsOn": [
        "^check"
      ]
    },
    "@bent-build/tesla-contracts#check": {
      "dependsOn": [
        "^check"
      ]
    },
    "@tesla-bridge/mcp-server#check": {
      "dependsOn": [
        "^check"
      ]
    },
    "@bent-build/drive-copilot-web#lint": {
      "dependsOn": [
        "^lint"
      ],
      "outputs": [
        ".cache/.eslintcache"
      ]
    },
    "@bent-build/tesla-contracts#lint": {
      "dependsOn": [
        "^lint"
      ],
      "outputs": [
        ".cache/.eslintcache"
      ]
    },
    "@tesla-bridge/mcp-server#lint": {
      "dependsOn": [
        "^lint"
      ],
      "outputs": [
        ".cache/.eslintcache"
      ]
    },
    "@bent-build/drive-copilot-web#test": {
      "dependsOn": [
        "^build"
      ]
    },
    "@bent-build/tesla-contracts#test": {
      "dependsOn": [
        "^build"
      ]
    },
    "@tesla-bridge/mcp-server#test": {
      "dependsOn": [
        "^build"
      ]
    },
    "@bent-build/drive-copilot-web#dev": {
      "cache": false,
      "persistent": true
    },
    "@bent-build/tesla-contracts#dev": {
      "cache": false,
      "persistent": true
    },
    "@tesla-bridge/mcp-server#dev": {
      "cache": false,
      "persistent": true
    }
  },
  "globalPassThroughEnv": [
    "CI",
    "NODE_ENV",
    "TEST_*",
    "E2E_*",
    "SKIP_ENV_VALIDATION",
    "NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY",
    "NEXT_PUBLIC_CLERK_SIGN_IN_URL",
    "CLERK_SECRET_KEY",
    "PAYLOAD_SECRET",
    "DATABASE_URI",
    "UPLOADTHING_TOKEN",
    "PUBLIC_HOME_*",
    "PAYLOAD_MIGRATION_TEST_DATABASE_URI",
    "PAYLOAD_STORAGE_SOURCE",
    "R2_BUCKET",
    "R2_ENDPOINT",
    "R2_PUBLIC_URL",
    "R2_ACCESS_KEY_ID",
    "R2_SECRET_ACCESS_KEY"
  ],
  "globalEnv": [
    "CI",
    "NODE_ENV",
    "NODE_OPTIONS"
  ],
  "globalDependencies": [
    "package.json",
    "apps/jp/patches/**"
  ]
}
