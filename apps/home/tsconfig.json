{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": false,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"],
      "@apartment-hotel/asset-contracts": [
        "./packages/asset-contracts/src/index.ts"
      ],
      "@apartment-hotel/scene-engine": [
        "./packages/scene-engine/src/index.ts"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "config/**/*.ts",
    "vite.config.ts",
    "vite.card.config.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    "packages/**/*.ts",
    ".agents/skills/**/*.ts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules", "dist", "examples"]
}
