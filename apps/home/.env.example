# Required build configuration. These values are visible in the rendered client.
# Keep the deployment's existing values in its protected environment settings.
PUBLIC_HOME_LATITUDE=
PUBLIC_HOME_LONGITUDE=
PUBLIC_HOME_BALCONY_BEARING=
PUBLIC_HOME_ALTITUDE_METRES=
# JSON build bindings for the private HA card. Use its existing configured entities.
PUBLIC_HOME_HA_BINDINGS={}
# Private release tooling. Never commit credentials or private layout data.
HOME_ASSISTANT_CHECKOUT=
HOME_ASSISTANT_BRIDGE=
HOME_ASSISTANT_BRIDGE_CHECKOUT=
HOME_ASSISTANT_SSH_TARGET=
HOME_ASSISTANT_SSH_IDENTITY=
HOME_ASSISTANT_URL=
