{
  "name": "@bent/fitness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 3025",
    "build": "vite build && tsc --noEmit",
    "typecheck": "bun scripts/routes.ts && tsc --noEmit",
    "lint": "eslint src tests e2e scripts *.ts",
    "test": "bun test tests/domain.test.ts tests/health.test.ts tests/devices.test.ts tests/clerk-sdk.test.ts",
    "test:integration": "bun test tests/*.integration.test.ts",
    "fixtures:wire": "FITNESS_WIRE_FIXTURES=update bun test tests/wire.integration.test.ts",
    "knip": "bun scripts/routes.ts && knip",
    "test:browser": "playwright test",
    "db:migrate": "bun scripts/migrate.ts"
  },
  "dependencies": {
    "@bent/design-tokens": "workspace:*",
    "@bent/fitness-contracts": "workspace:*",
    "@bent/ui": "workspace:*",
    "@clerk/shared": "4.45.1",
    "@clerk/tanstack-react-start": "1.7.13",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-start": "1.169.5",
    "postgres": "3.4.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/bun": "1.3.14",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.0.2",
    "eslint": "9.39.5",
    "knip": "6.44.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.1.6",
    "@playwright/test": "1.64.1",
    "nitro": "3.0.261103-rc",
    "@clerk/testing": "2.3.0",
    "@tanstack/router-generator": "1.168.0"
  }
}
