{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/routes/**/*.{ts,tsx}",
    "tests/**/*.test.ts",
    "tests/preload.ts",
    "e2e/**/*.spec.ts",
    "scripts/*.ts"
  ],
  "project": [
    "src/**/*.{ts,tsx}",
    "tests/**/*.ts",
    "e2e/**/*.ts",
    "scripts/*.ts"
  ],
  "ignoreDependencies": ["@bent/design-tokens"]
}
