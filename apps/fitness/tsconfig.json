{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": ["vite/client", "bun"],
    "resolveJsonModule": true
  },
  "include": [
    "src",
    "tests",
    "vite.config.ts",
    "e2e",
    "playwright.config.ts",
    "scripts"
  ]
}
