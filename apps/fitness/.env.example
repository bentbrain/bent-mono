VITE_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
DATABASE_URL=
# Comma-separated verified email addresses, server only. An empty list denies access.
FITNESS_ALLOWED_EMAILS=
# MCP endpoint that OAuth tokens must name as their audience. Defaults to the production URL.
FITNESS_MCP_URL=http://127.0.0.1:3025/api/mcp
# iPhone sync enrollment. Set to "enabled" only after applying schema.sql and configuring the Clerk OAuth application.
FITNESS_DEVICE_ENROLLMENT=
# Comma-separated Clerk OAuth application IDs of the bent Fitness iPhone app.
FITNESS_DEVICE_CLIENT_IDS=
# Set to "enabled" once Clerk issues the fitness:targets scope, so assistants request it.
FITNESS_TARGETS_SCOPE=
