{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noUncheckedIndexedAccess": true,
    "allowImportingTsExtensions": true,
    "types": ["bun"]
  },
  "include": [
    "index.ts",
    "app.config.ts",
    "src",
    "tests",
    "modules/fitness-health/index.ts",
    "modules/workout-activity/index.ts",
    "uniwind-types.d.ts",
    "css.d.ts"
  ]
}
