{
  "name": "@bent/fitness-ios",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "start": "APP_VARIANT=development expo start",
    "config:development": "APP_VARIANT=development expo config --type public --json",
    "config:production": "APP_VARIANT=production expo config --type public --json",
    "prebuild": "EXPO_NO_GIT_STATUS=1 expo prebuild --platform ios --clean",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests scripts modules/fitness-health/index.ts modules/fitness-health/app.plugin.js index.ts app.config.ts babel.config.js metro.config.js eslint.config.mjs",
    "test": "bun test tests",
    "knip": "knip",
    "doctor": "expo-doctor",
    "fingerprint:check": "node scripts/fingerprint-check.mjs",
    "native:build": "node scripts/native.mjs build",
    "native:test": "node scripts/native.mjs core-test",
    "roundtrip": "node scripts/roundtrip.mjs",
    "eas-build-post-install": "node scripts/native.mjs xcode 26.6"
  },
  "dependencies": {
    "@bent/design-tokens": "workspace:*",
    "expo": "58.0.26",
    "expo-application": "58.1.2",
    "expo-auth-session": "58.0.19",
    "expo-constants": "58.0.16",
    "expo-crypto": "58.0.8",
    "expo-web-browser": "58.1.0",
    "react": "19.3.1",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "5.11.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@expo/fingerprint": "0.21.10",
    "@types/bun": "1.3.14",
    "@types/react": "19.3.0",
    "eslint": "9.39.5",
    "expo-doctor": "1.21.8",
    "globals": "17.14.0",
    "knip": "6.44.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  },
  "expo": {
    "install": {
      "exclude": [
        "react"
      ]
    }
  }
}
