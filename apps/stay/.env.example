# Get these from Clerk. Real keys belong in .env.local and Vercel.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_APP_URL=http://localhost:3015
# Only the verified owner email can manage invitations.
OWNER_EMAIL=
# Optional locally; deployed Vercel projects use OIDC automatically.
AI_GATEWAY_API_KEY=
AI_MODEL=google/gemini-2.5-flash-lite
# Server-only connection to the limited Mac mini controls bridge.
HOME_CONTROL_BRIDGE_URL=
HOME_CONTROL_BRIDGE_TOKEN=
# Server-only CMS storage. Vercel provisions this when connecting the private store.
BLOB_READ_WRITE_TOKEN=
# Private legacy home dashboard URL. Served only through the authenticated redirect.
HOME_CONTROLS_URL=
# Existing connected private Blob store; Vercel uses OIDC for access.
BLOB_STORE_ID=
# Controls host only. Never set these on the browser or commit real values.
HOME_ASSISTANT_URL=
HOME_ASSISTANT_TOKEN=
