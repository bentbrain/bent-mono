{
  "name": "maya-collage",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "next build",
    "check": "bun run lint && tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "dev": "next dev",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "format:write": "prettier --write \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "migration:classify-references": "tsx scripts/migration/classify-references.ts",
    "migration:copy-uploadthing": "tsx scripts/migration/copy-uploadthing-to-r2.ts",
    "migration:export-postgres": "tsx scripts/migration/export-postgres.ts",
    "migration:inventory-uploadthing": "tsx scripts/migration/inventory-uploadthing.ts",
    "migration:promote-r2": "tsx scripts/migration/promote-r2-objects.ts",
    "migration:prepare-convex-import": "tsx scripts/migration/prepare-convex-import.ts",
    "preview": "next build && next start",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf .next && rm -rf node_modules && rm -rf .turbo && rm -rf .drizzle",
    "knip": "SKIP_ENV_VALIDATION=1 knip",
    "test:security": "node --import tsx --test tests/convex-security.test.ts",
    "test:auth": "node --import tsx --test tests/clerk-handshake.test.ts",
    "migration:payload-storage-schema": "tsx scripts/migration/payload-storage-schema.ts",
    "test:storage-schema": "node --import tsx --test tests/payload-storage-schema.test.ts",
    "test": "bun run test:security && bun run test:auth && bun run test:storage-schema"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1162.0",
    "@aws-sdk/s3-request-presigner": "3.1162.0",
    "@clerk/backend": "3.26.5",
