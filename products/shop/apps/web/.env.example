# Shopify Hydrogen storefront
PUBLIC_STORE_DOMAIN="your-shop.myshopify.com"
PUBLIC_STOREFRONT_API_TOKEN=""
PRIVATE_STOREFRONT_API_TOKEN=""

# Local hostname or LAN address allowed to load Next.js development assets
LAN_DEV_ORIGIN="127.0.0.1"

# Shared Effect API Worker. Use the deployed URL in Vercel environments.
FOREVER_TEE_API_URL="http://127.0.0.1:8787"
FOREVER_TEE_API_SHARED_SECRET=""
NEXT_PUBLIC_FOREVER_TEE_API_URL="http://127.0.0.1:8787"

# Managed Turnstile challenge. The secret is server-only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET=""
TURNSTILE_TEST_MODE="1"

# Optional browser analytics. Leave both empty to disable capture.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=""
NEXT_PUBLIC_POSTHOG_HOST=""
# Server-only source-map upload credentials for release builds.
POSTHOG_CLI_API_KEY=""
POSTHOG_CLI_PROJECT_ID=""
POSTHOG_CLI_HOST=""

# Vercel Production only: set to exactly 1 to enforce the Worker-first build
# gate. Omit this variable from Preview, Development, and local environments.
# FOREVER_TEE_ENFORCE_WORKER_RELEASE="1"
