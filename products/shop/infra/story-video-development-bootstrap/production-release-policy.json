{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": "arn:aws:s3:::forever-tee-terraform-state-{{SHOP:awsAccountId}}-ap-southeast-2",
      "Condition": {
        "StringEquals": {
          "s3:prefix": [
            "story-video/production/terraform.tfstate",
            "story-video/production/terraform.tfstate.tflock"
          ]
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "s3:GetBucketLocation",
        "s3:GetBucketVersioning",
        "s3:GetEncryptionConfiguration",
        "s3:GetBucketPublicAccessBlock",
        "s3:GetBucketPolicy"
      ],
      "Resource": "arn:aws:s3:::forever-tee-terraform-state-{{SHOP:awsAccountId}}-ap-southeast-2"
    },
    {
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject"
      ],
      "Resource": "arn:aws:s3:::forever-tee-terraform-state-{{SHOP:awsAccountId}}-ap-southeast-2/story-video/production/terraform.tfstate"
    },
    {
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject"
      ],
      "Resource": "arn:aws:s3:::forever-tee-terraform-state-{{SHOP:awsAccountId}}-ap-southeast-2/story-video/production/terraform.tfstate.tflock"
    },
    {
      "Effect": "Allow",
      "Action": [
        "kms:Encrypt",
        "kms:Decrypt",
        "kms:GenerateDataKey"
      ],
      "Resource": "arn:aws:kms:ap-southeast-2:{{SHOP:awsAccountId}}:key/{{SHOP:stateKmsKeyId}}",
      "Condition": {
        "StringEquals": {
          "kms:ViaService": "s3.ap-southeast-2.amazonaws.com",
          "kms:CallerAccount": "{{SHOP:awsAccountId}}",
          "kms:EncryptionContext:aws:s3:arn": [
            "arn:aws:s3:::forever-tee-terraform-state-{{SHOP:awsAccountId}}-ap-southeast-2/story-video/production/terraform.tfstate",
            "arn:aws:s3:::forever-tee-terraform-state-{{SHOP:awsAccountId}}-ap-southeast-2/story-video/production/terraform.tfstate.tflock"
          ]
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:GetBucketLocation",
        "s3:GetBucketAcl",
        "s3:GetBucketVersioning",
        "s3:GetEncryptionConfiguration",
        "s3:GetBucketPublicAccessBlock",
        "s3:GetBucketPolicy",
        "s3:GetBucketTagging",
        "s3:GetBucketOwnershipControls",
        "s3:GetBucketCors",
        "s3:GetBucketWebsite",
        "s3:GetAccelerateConfiguration",
        "s3:GetLifecycleConfiguration",
        "s3:GetReplicationConfiguration",
        "s3:GetBucketObjectLockConfiguration",
        "s3:GetBucketRequestPayment",
        "s3:GetBucketLogging"
      ],
      "Resource": "arn:aws:s3:::forever-tee-video-production-{{SHOP:awsAccountId}}-ap-southeast-2"
    },
    {
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:GetObjectVersion",
        "s3:PutObject"
      ],
      "Resource": "arn:aws:s3:::forever-tee-video-production-{{SHOP:awsAccountId}}-ap-southeast-2/source/*"
    },
    {
      "Effect": "Allow",
      "Action": [
        "sqs:GetQueueAttributes",
        "sqs:GetQueueUrl",
        "sqs:ListQueueTags"
      ],
      "Resource": [
        "arn:aws:sqs:ap-southeast-2:{{SHOP:awsAccountId}}:forever-tee-video-production-failures",
        "arn:aws:sqs:ap-southeast-2:{{SHOP:awsAccountId}}:forever-tee-video-production-failures-dead-letter"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "logs:ListTagsForResource",
        "logs:ListTagsLogGroup"
      ],
      "Resource": [
        "arn:aws:logs:ap-southeast-2:{{SHOP:awsAccountId}}:log-group:/aws/lambda/forever-tee-video-production",
        "arn:aws:logs:ap-southeast-2:{{SHOP:awsAccountId}}:log-group:/aws/lambda/forever-tee-video-production:*",
        "arn:aws:logs:ap-southeast-2:{{SHOP:awsAccountId}}:log-group:/aws/lambda/forever-tee-video-production-failures",
        "arn:aws:logs:ap-southeast-2:{{SHOP:awsAccountId}}:log-group:/aws/lambda/forever-tee-video-production-failures:*"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "sns:GetTopicAttributes",
        "sns:ListTagsForResource",
        "sns:ListSubscriptionsByTopic",
        "sns:Publish"
      ],
      "Resource": "arn:aws:sns:ap-southeast-2:{{SHOP:awsAccountId}}:forever-tee-video-production-alerts"
    },
    {
      "Effect": "Allow",
      "Action": [
        "sns:GetSubscriptionAttributes"
      ],
      "Resource": "arn:aws:sns:ap-southeast-2:{{SHOP:awsAccountId}}:forever-tee-video-production-alerts"
    },
    {
      "Effect": "Allow",
      "Action": [
        "cloudwatch:PutMetricAlarm",
        "cloudwatch:DescribeAlarms",
        "cloudwatch:ListTagsForResource",
        "cloudwatch:TagResource"
      ],
      "Resource": "arn:aws:cloudwatch:ap-southeast-2:{{SHOP:awsAccountId}}:alarm:forever-tee-video-production-*"
    },
    {
      "Effect": "Allow",
      "Action": [
        "lambda:GetAccountSettings",
        "logs:DescribeLogGroups",
        "cloudwatch:GetMetricStatistics",
        "lambda:ListEventSourceMappings"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-southeast-2"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "lambda:CreateFunction",
        "lambda:UpdateFunctionCode",
        "lambda:UpdateFunctionConfiguration",
        "lambda:PutFunctionConcurrency",
        "lambda:PutFunctionEventInvokeConfig",
        "lambda:InvokeFunction",
        "lambda:GetFunction",
        "lambda:GetFunctionConfiguration",
        "lambda:GetFunctionConcurrency",
        "lambda:GetFunctionEventInvokeConfig",
        "lambda:GetFunctionCodeSigningConfig",
        "lambda:GetPolicy",
        "lambda:ListVersionsByFunction",
        "lambda:ListTags",
        "lambda:TagResource"
      ],
      "Resource": [
        "arn:aws:lambda:ap-southeast-2:{{SHOP:awsAccountId}}:function:forever-tee-video-production",
        "arn:aws:lambda:ap-southeast-2:{{SHOP:awsAccountId}}:function:forever-tee-video-production-failures"
      ]
    },
    {
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": [
        "arn:aws:iam::{{SHOP:awsAccountId}}:role/forever-tee-video-production-runtime",
        "arn:aws:iam::{{SHOP:awsAccountId}}:role/forever-tee-video-production-failures"
      ],
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "lambda.amazonaws.com"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "lambda:CreateEventSourceMapping",
        "lambda:GetEventSourceMapping",
        "lambda:UpdateEventSourceMapping"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-southeast-2"
        },
        "ArnEquals": {
          "lambda:FunctionArn": "arn:aws:lambda:ap-southeast-2:{{SHOP:awsAccountId}}:function:forever-tee-video-production-failures"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": "lambda:ListTags",
      "Resource": "arn:aws:lambda:ap-southeast-2:{{SHOP:awsAccountId}}:event-source-mapping:*"
    },
    {
      "Effect": "Allow",
      "Action": [
        "ecr:DescribeRepositories",
        "ecr:DescribeImages",
        "ecr:GetRepositoryPolicy",
        "ecr:BatchGetImage",
        "ecr:GetDownloadUrlForLayer"
      ],
      "Resource": "arn:aws:ecr:ap-southeast-2:{{SHOP:awsAccountId}}:repository/forever-tee-video-development"
    },
    {
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:GetObjectVersion"
      ],
      "Resource": [
        "arn:aws:s3:::forever-tee-video-development-{{SHOP:awsAccountId}}-ap-southeast-2/source/candidates/{{SHOP:resource_04efe2fdbe6d}}/{{SHOP:resource_7acc6e376e5e}}.json",
        "arn:aws:s3:::forever-tee-video-development-{{SHOP:awsAccountId}}-ap-southeast-2/source/{{SHOP:qualifiedCandidateSourceCommit}}/{{SHOP:resource_7acc6e376e5e}}/*",
        "arn:aws:s3:::forever-tee-video-development-{{SHOP:awsAccountId}}-ap-southeast-2/source/releases/native-{{SHOP:resource_8d0190ecec7d}}/*"
      ]
    },
    {
      "Effect": "Allow",
      "Action": "codebuild:BatchGetBuilds",
      "Resource": "arn:aws:codebuild:ap-southeast-2:{{SHOP:awsAccountId}}:project/forever-tee-video-development"
    }
  ]
}
