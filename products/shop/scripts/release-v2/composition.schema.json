{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shop.bent.build/contracts/release-composition-v1",
  "$ref": "#/$defs/envelope",
  "$defs": {
    "digest": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[a-f0-9]{64}$"
    },
    "commit": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[a-f0-9]{40}$"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "integer": {
      "type": "integer",
      "minimum": 0
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[^\\u0000-\\u001f\\u007f\\\\:?#%]+$"
    },
    "ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "bytes"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/path"
        },
        "sha256": {
          "$ref": "#/$defs/digest"
        },
        "bytes": {
          "$ref": "#/$defs/integer"
        }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/path"
        },
        "sha256": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ownerId",
        "repositoryId"
      ],
      "properties": {
        "ownerId": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "repositoryId": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "current",
        "previous",
        "accepts",
        "emits",
        "capabilities",
        "requiresCapabilities",
        "storageReads",
        "storageWrites",
        "jobHandlers",
        "rollbackRequirements"
      ],
      "properties": {
        "current": {
          "$ref": "#/$defs/id"
        },
        "previous": {
          "$ref": "#/$defs/id"
        },
        "accepts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "maxItems": 128,
          "minItems": 0,
          "uniqueItems": true
        },
        "emits": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "maxItems": 128,
          "minItems": 0,
          "uniqueItems": true
        },
        "capabilities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "maxItems": 128,
          "minItems": 0,
          "uniqueItems": true
        },
        "requiresCapabilities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "maxItems": 128,
          "minItems": 0,
          "uniqueItems": true
        },
        "storageReads": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "maxItems": 128,
          "minItems": 0,
          "uniqueItems": true
        },
        "storageWrites": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "maxItems": 128,
          "minItems": 0,
          "uniqueItems": true
        },
        "jobHandlers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "maxItems": 128,
          "minItems": 0,
          "uniqueItems": true
        },
        "rollbackRequirements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "maxItems": 128,
          "minItems": 0,
          "uniqueItems": true
        }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "originSourceCommit",
        "sourceTreeDigest",
        "inputsDigest",
        "intentInputsDigest",
        "inputsRef",
        "intentInputsRef",
        "artifact",
        "config",
        "provenance",
        "contract"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "originSourceCommit": {
          "$ref": "#/$defs/commit"
        },
        "sourceTreeDigest": {
          "$ref": "#/$defs/digest"
        },
        "inputsDigest": {
          "$ref": "#/$defs/digest"
        },
        "intentInputsDigest": {
          "$ref": "#/$defs/digest"
        },
        "artifact": {
          "$ref": "#/$defs/ref"
        },
        "config": {
          "$ref": "#/$defs/ref"
        },
        "provenance": {
          "$ref": "#/$defs/ref"
        },
        "contract": {
          "$ref": "#/$defs/contract"
        },
        "inputsRef": {
          "$ref": "#/$defs/ref"
        },
        "intentInputsRef": {
          "$ref": "#/$defs/ref"
        }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "producer",
        "consumer",
        "formats",
        "capabilities"
      ],
      "properties": {
        "producer": {
          "$ref": "#/$defs/id"
        },
        "consumer": {
          "$ref": "#/$defs/id"
        },
        "formats": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "maxItems": 128,
          "minItems": 0,
          "uniqueItems": true
        },
        "capabilities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "maxItems": 128,
          "minItems": 0,
          "uniqueItems": true
        }
      }
    },
    "proof": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "receipt"
      ],
      "properties": {
        "kind": {
          "enum": [
            "source",
            "security",
            "review",
            "artifact",
            "compatibility",
            "qualification",
            "owner"
          ]
        },
        "receipt": {
          "$ref": "#/$defs/ref"
        }
      }
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "repository",
        "target",
        "intentSourceCommit",
        "baseCommit",
        "createdAt",
        "policyDigest",
        "parentCompositionDigest",
        "rollbackCompositionDigest",
        "changeClass",
        "schemaState",
        "components",
        "dependencies",
        "proofRefs"
      ],
      "properties": {
        "schema": {
          "const": "shop.release-composition/v1"
        },
        "repository": {
          "$ref": "#/$defs/repository"
        },
        "target": {
          "const": "inactive-local"
        },
        "intentSourceCommit": {
          "$ref": "#/$defs/commit"
        },
        "baseCommit": {
          "$ref": "#/$defs/commit"
        },
        "createdAt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "policyDigest": {
          "$ref": "#/$defs/digest"
        },
        "parentCompositionDigest": {
          "anyOf": [
            {
              "$ref": "#/$defs/digest"
            },
            {
              "type": "null"
            }
          ]
        },
        "rollbackCompositionDigest": {
          "anyOf": [
            {
              "$ref": "#/$defs/digest"
            },
            {
              "type": "null"
            }
          ]
        },
        "changeClass": {
          "enum": [
            "compatible",
            "migration"
          ]
        },
        "schemaState": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "epoch",
            "ledgerDigest",
            "rollbackEpochs"
          ],
          "properties": {
            "epoch": {
              "$ref": "#/$defs/integer"
            },
            "ledgerDigest": {
              "$ref": "#/$defs/digest"
            },
            "rollbackEpochs": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/integer"
              },
              "maxItems": 128,
              "minItems": 0,
              "uniqueItems": true
            }
          }
        },
        "components": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/component"
          },
          "maxItems": 32,
          "minItems": 1,
          "uniqueItems": true
        },
        "dependencies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/edge"
          },
          "maxItems": 1024,
          "minItems": 0,
          "uniqueItems": true
        },
        "proofRefs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/proof"
          },
          "maxItems": 256,
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "payloadType",
        "payloadDigest",
        "keyId",
        "algorithm",
        "signer",
        "signature"
      ],
      "properties": {
        "payloadType": {
          "const": "shop.release-composition/v1"
        },
        "payloadDigest": {
          "$ref": "#/$defs/digest"
        },
        "keyId": {
          "$ref": "#/$defs/id"
        },
        "algorithm": {
          "const": "ECDSA_SHA_256"
        },
        "signer": {
          "const": "local-fixture"
        },
        "signature": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^[A-Za-z0-9+/]+={0,2}$"
        }
      }
    },
    "envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "payload",
        "signature"
      ],
      "properties": {
        "payload": {
          "$ref": "#/$defs/payload"
        },
        "signature": {
          "$ref": "#/$defs/signature"
        }
      }
    },
    "artifactFile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "bytes",
        "mediaType"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/path"
        },
        "sha256": {
          "$ref": "#/$defs/digest"
        },
        "bytes": {
          "$ref": "#/$defs/integer"
        },
        "mediaType": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "component",
        "format",
        "entrypoint",
        "files",
        "originSourceCommit",
        "inputsDigest",
        "configDigest",
        "provenanceDigest",
        "root"
      ],
      "properties": {
        "schema": {
          "const": "shop.artifact/v1"
        },
        "component": {
          "$ref": "#/$defs/id"
        },
        "format": {
          "enum": [
            "module-bundle",
            "oci-layout"
          ]
        },
        "entrypoint": {
          "$ref": "#/$defs/path"
        },
        "files": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/artifactFile"
          },
          "maxItems": 4096,
          "minItems": 1,
          "uniqueItems": true
        },
        "originSourceCommit": {
          "$ref": "#/$defs/commit"
        },
        "inputsDigest": {
          "$ref": "#/$defs/digest"
        },
        "configDigest": {
          "$ref": "#/$defs/digest"
        },
        "provenanceDigest": {
          "$ref": "#/$defs/digest"
        },
        "root": {
          "$ref": "#/$defs/path"
        }
      }
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "component",
        "fixture",
        "bindings"
      ],
      "properties": {
        "schema": {
          "const": "shop.fixture-config/v1"
        },
        "component": {
          "$ref": "#/$defs/id"
        },
        "fixture": {
          "const": true
        },
        "bindings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "valueDigest"
            ],
            "properties": {
              "name": {
                "$ref": "#/$defs/id"
              },
              "valueDigest": {
                "$ref": "#/$defs/digest"
              }
            }
          },
          "maxItems": 128,
          "minItems": 0,
          "uniqueItems": true
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "component",
        "originSourceCommit",
        "sourceTreeDigest",
        "inputsDigest",
        "artifactFilesDigest",
        "recipeDigest",
        "toolchainDigest",
        "dependencyLockDigest"
      ],
      "properties": {
        "schema": {
          "const": "shop.fixture-provenance/v1"
        },
        "component": {
          "$ref": "#/$defs/id"
        },
        "originSourceCommit": {
          "$ref": "#/$defs/commit"
        },
        "sourceTreeDigest": {
          "$ref": "#/$defs/digest"
        },
        "inputsDigest": {
          "$ref": "#/$defs/digest"
        },
        "artifactFilesDigest": {
          "$ref": "#/$defs/digest"
        },
        "recipeDigest": {
          "$ref": "#/$defs/digest"
        },
        "toolchainDigest": {
          "$ref": "#/$defs/digest"
        },
        "dependencyLockDigest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "scope",
        "kind",
        "subjectDigest",
        "inputsDigest",
        "policyDigest",
        "verifierDigest",
        "evidence"
      ],
      "properties": {
        "schema": {
          "const": "shop.fixture-receipt/v1"
        },
        "scope": {
          "const": "inactive-local"
        },
        "kind": {
          "$ref": "#/$defs/id"
        },
        "subjectDigest": {
          "$ref": "#/$defs/digest"
        },
        "inputsDigest": {
          "$ref": "#/$defs/digest"
        },
        "policyDigest": {
          "$ref": "#/$defs/digest"
        },
        "verifierDigest": {
          "$ref": "#/$defs/digest"
        },
        "evidence": {
          "$ref": "#/$defs/ref"
        }
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit",
        "root",
        "treeDigest"
      ],
      "properties": {
        "commit": {
          "$ref": "#/$defs/commit"
        },
        "root": {
          "$ref": "#/$defs/path"
        },
        "treeDigest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "runner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "script",
        "executableDigest",
        "timeoutMs",
        "requiredObservations",
        "origins",
        "id"
      ],
      "properties": {
        "script": {
          "$ref": "#/$defs/ref"
        },
        "executableDigest": {
          "$ref": "#/$defs/digest"
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 120000
        },
        "requiredObservations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "maxItems": 128,
          "minItems": 1,
          "uniqueItems": true
        },
        "origins": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^http://127\\.0\\.0\\.1:[1-9][0-9]{0,4}$"
          },
          "uniqueItems": true,
          "maxItems": 16
        },
        "id": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "trust": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "scope",
        "repository",
        "intentCommits",
        "baseCommit",
        "keyId",
        "publicKeyPem",
        "keyFingerprint",
        "implementationDigest",
        "inputPaths",
        "snapshots",
        "runner",
        "budgetMs",
        "requiredProofKinds"
      ],
      "properties": {
        "schema": {
          "const": "shop.fixture-trust/v1"
        },
        "scope": {
          "const": "inactive-loopback"
        },
        "repository": {
          "$ref": "#/$defs/repository"
        },
        "intentCommits": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/commit"
          },
          "maxItems": 32,
          "minItems": 1,
          "uniqueItems": true
        },
        "baseCommit": {
          "$ref": "#/$defs/commit"
        },
        "keyId": {
          "$ref": "#/$defs/id"
        },
        "publicKeyPem": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "keyFingerprint": {
          "$ref": "#/$defs/digest"
        },
        "implementationDigest": {
          "$ref": "#/$defs/digest"
        },
        "inputPaths": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/path"
          },
          "maxItems": 16384,
          "minItems": 1,
          "uniqueItems": true
        },
        "snapshots": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/snapshot"
          },
          "maxItems": 32,
          "minItems": 1,
          "uniqueItems": true
        },
        "runner": {
          "$ref": "#/$defs/runner"
        },
        "budgetMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600000
        },
        "requiredProofKinds": {
          "const": [
            "source",
            "security",
            "review",
            "artifact",
            "compatibility",
            "qualification",
            "owner"
          ]
        }
      }
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "files"
      ],
      "properties": {
        "schema": {
          "const": "shop.full-inputs/v1"
        },
        "files": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/input"
          },
          "minItems": 1,
          "maxItems": 16384,
          "uniqueItems": true
        }
      }
    }
  }
}
