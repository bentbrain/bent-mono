# Safe defaults. Auto uses live mode only when a protected local token file exists.
TESLA_MODE=auto
TESLA_ACTIONS_ENABLED=false
TESLA_BRIDGE_PORT=8787

# Developer-only live Fleet API mode.
TESLA_ACCESS_TOKEN=
TESLA_CLIENT_ID=
TESLA_TOKEN_FILE=
TESLA_TOKEN_ENDPOINT=https://fleet-auth.prd.vn.cloud.tesla.com/oauth2/v3/token
TESLA_FLEET_API_BASE_URL=https://fleet-api.prd.na.vn.cloud.tesla.com
TESLA_COMMAND_PROXY_URL=http://127.0.0.1:4443
